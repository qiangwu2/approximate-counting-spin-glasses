import Manuscript.SupportIndices
import Manuscript.Model

/-! Output-sensitive generation of the physical mixed-interaction input array.
Each active cardinality is generated by pruned include/exclude recursion. -/

noncomputable section
open scoped BigOperators
namespace Manuscript.InputIndices
open SupportIndices

def layer (N p : ℕ) : List (Finset (Fin N)) :=
  certifiedChoices p Finset.univ.toList Finset.univ.nodup_toList

theorem mem_layer (N p : ℕ) (e : Finset (Fin N)) : e ∈ layer N p ↔ e.card = p := by
  rw [layer, certifiedChoices_eq, ← List.mem_toFinset,
    chosenFinsets_toFinset p Finset.univ.toList Finset.univ.nodup_toList]
  simp

theorem layer_nodup (N p : ℕ) : (layer N p).Nodup := by
  rw [layer, certifiedChoices_eq]
  exact chosenFinsets_nodup _ _ Finset.univ.nodup_toList

@[simp] theorem layer_length (N p : ℕ) : (layer N p).length = N.choose p := by
  simp [layer, certifiedChoices_eq, chosenFinsets_length]

def orderEdges (N : ℕ) (P : Finset ℕ) (p : ℕ) (hp : p ∈ P) : List (Model.Edge N P) :=
  (layer N p).attach.map (fun e => ⟨e.val, Model.mem_physicalEdges.mpr
    (by rw [(mem_layer N p e.val).mp e.property]; exact hp)⟩)

theorem mem_orderEdges (N : ℕ) (P : Finset ℕ) (p : ℕ) (hp : p ∈ P)
    (e : Model.Edge N P) : e ∈ orderEdges N P p hp ↔ e.val.card = p := by
  constructor
  · intro he
    obtain ⟨f, hf, rfl⟩ := List.mem_map.mp he
    exact (mem_layer N p f.val).mp f.property
  · intro he
    apply List.mem_map.mpr
    refine ⟨⟨e.val, (mem_layer N p e.val).mpr he⟩, List.mem_attach _ _, ?_⟩
    exact Subtype.ext rfl

theorem orderEdges_nodup (N : ℕ) (P : Finset ℕ) (p : ℕ) (hp : p ∈ P) :
    (orderEdges N P p hp).Nodup := by
  apply List.Nodup.map _ (List.nodup_attach.mpr (layer_nodup N p))
  intro e f hef
  exact Subtype.ext (congrArg (fun x : Model.Edge N P => x.val) hef)

@[simp] theorem orderEdges_length (N : ℕ) (P : Finset ℕ) (p : ℕ) (hp : p ∈ P) :
    (orderEdges N P p hp).length = N.choose p := by simp [orderEdges]

def edges (N : ℕ) (P : Finset ℕ) : List (Model.Edge N P) :=
  P.attach.toList.flatMap (fun p => orderEdges N P p.val p.property)

theorem edges_mem (N : ℕ) (P : Finset ℕ) (e : Model.Edge N P) : e ∈ edges N P := by
  apply List.mem_flatMap.mpr
  refine ⟨⟨e.val.card, Model.edge_order_mem e⟩, by simp, ?_⟩
  exact (mem_orderEdges _ _ _ _ _).mpr rfl

theorem edges_toFinset (N : ℕ) (P : Finset ℕ) : (edges N P).toFinset = Finset.univ := by
  ext e
  simp [edges_mem]

theorem edges_nodup (N : ℕ) (P : Finset ℕ) : (edges N P).Nodup := by
  apply List.nodup_flatMap.mpr
  constructor
  · intro p hp
    exact orderEdges_nodup _ _ _ _
  · apply (P.attach.nodup_toList).imp
    intro p q hpq
    intro e hep heq
    have he1 := (mem_orderEdges N P p.val p.property e).mp hep
    have he2 := (mem_orderEdges N P q.val q.property e).mp heq
    exact hpq (Subtype.ext (he1.symm.trans he2))

@[simp] theorem edges_length (N : ℕ) (P : Finset ℕ) :
    (edges N P).length = Fintype.card (Model.Edge N P) := by
  rw [← List.toFinset_card_of_nodup (edges_nodup N P), edges_toFinset, Finset.card_univ]

theorem edges_sum {R : Type*} [AddCommMonoid R] (N : ℕ) (P : Finset ℕ)
    (f : Model.Edge N P → R) : ((edges N P).map f).sum = ∑ e, f e := by
  rw [← List.sum_toFinset _ (edges_nodup N P), edges_toFinset]

/-- Recursive generation, certified packing, subtype tagging and concatenation
are charged per active order. The vertex list is prepared once. -/
def generationWork (N : ℕ) (P : Finset ℕ) : ℕ :=
  N + ∑ p ∈ P, (chooseWork N p + 4 * N.choose p + 2)

theorem generationWork_le {N : ℕ} (P : Finset ℕ) (hPN : ∀ p ∈ P, p ≤ N) :
    generationWork N P ≤ N + 9 * (N + 1) ^ 2 * ∑ p ∈ P, N.choose p := by
  unfold generationWork
  apply Nat.add_le_add_left
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro p hp
  have h := chooseWork_with_pack (hPN p hp)
  have hc := Nat.choose_pos (hPN p hp)
  have hN : 1 ≤ (N + 1) ^ 2 := by nlinarith
  nlinarith

theorem card_edges_eq_sum_choose (N : ℕ) (P : Finset ℕ) :
    Fintype.card (Model.Edge N P) = ∑ p ∈ P, N.choose p := by
  rw [← edges_length]
  simp only [edges, List.length_flatMap, orderEdges_length]
  rw [← List.sum_toFinset _ P.attach.nodup_toList]
  simp
  exact Finset.sum_attach P (fun p => N.choose p)

theorem card_edges_le {N Pmax : ℕ} (hN : 0 < N) (P : Finset ℕ)
    (hP : ∀ p ∈ P, p ≤ Pmax) : Fintype.card (Model.Edge N P) ≤ P.card * N ^ Pmax := by
  rw [card_edges_eq_sum_choose]
  calc
    _ ≤ ∑ _p ∈ P, N ^ Pmax := Finset.sum_le_sum (fun p hp =>
      (Nat.choose_le_pow N p).trans (Nat.pow_le_pow_right hN (hP p hp)))
    _ = _ := by simp

end Manuscript.InputIndices
