                                              Manuscript.RestrictedHigherLayer.table
                                              (Manuscript.RestrictedParameters.higher pmax P a B rho pmin)
                                              (Manuscript.RestrictedInputEncoding.encode order beta h epsilon delta J
                                                tape)
                                              (Manuscript.RestrictedHigherEndpoint.program pmax P a B rho pmin)
                                              Manuscript.RestrictedMachine.initial count final ∧
                                            final.realReg 3 =
                                                (Manuscript.HigherOrderFinal.execute N pmax P a B rho pmin beta h
                                                    epsilon delta J).value ∧
                                              ↑count ≤ C * ↑N ^ C * epsilon ^ (-C) * delta ^ (-C)
