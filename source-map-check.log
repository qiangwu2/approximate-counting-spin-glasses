Manuscript.ConditionalLowerTail.exponent_eq_inv_sqrt_sub_one {θ : ℝ} (hθ : 0 < θ) :
  Manuscript.ConditionalLowerTail.exponent θ = (√θ)⁻¹ - 1
Manuscript.ConditionalLowerTail.reverse_hypercontractivity.{u_2} {E : Type u_2} [Fintype E] [DecidableEq E] {θ q s : ℝ}
  (hq : 0 < q) (hq1 : q < 1) (hs : 0 < s) (hθ : 0 < θ) (hparam : θ ≤ (1 - q) / (1 + s)) (f : (E → Bool) → ℝ)
  (hf : ∀ (η : E → Bool), 0 < f η) :
  (SpinGlass.Expansion.spinMean fun η => f η ^ q) ^ (1 / q) ≤
    (SpinGlass.Expansion.spinMean fun η => SpinGlass.Noise.cubeNoise θ f η ^ (-s)) ^ (1 / -s)
Manuscript.CurrentCutoff.lemma_5_1 (P : ℕ) {kapMin A c1 CΛ : ℝ} (hkapMin : 0 < kapMin) (hA : 1 ≤ A) (hc1 : 0 < c1)
  (hCΛ : 1 ≤ CΛ) :
  0 < Manuscript.Cutoffs.gamma kapMin A ∧
    Manuscript.Cutoffs.gamma kapMin A < 1 / 4 ∧
      0 < Manuscript.Cutoffs.nu kapMin A c1 ∧
        P ≤ Manuscript.Cutoffs.sizeThreshold P kapMin A ∧
          ∀ (N : ℕ) (kap u : ℝ),
            Manuscript.Cutoffs.sizeThreshold P kapMin A ≤ N →
              kapMin ≤ kap →
                0 < u →
                  u < 1 →
                    CΛ * Real.exp (-Manuscript.Cutoffs.nu kapMin A c1 * ↑N) < u →
                      ∃ k < ⌊Manuscript.Cutoffs.gamma kapMin A * ↑N⌋₊,
                        Real.exp (-SpinGlass.CutoffTail.phi kap A ↑N ↑(k + 1)) ≤ u / CΛ ∧
                          (∀ (t : ℝ),
                              1 ≤ t →
                                0 < Manuscript.Cutoffs.workConstant kapMin A t ∧
                                  ∑ j ∈ Finset.range (k + 1), ↑(N.choose j) * t ^ j ≤
                                    (↑N + 1) * (CΛ / u) ^ Manuscript.Cutoffs.workConstant kapMin A t) ∧
                            (Manuscript.CutoffExecution.cutoffSearch kapMin kap A N (Real.log (CΛ / u))).found =
                                some (k + 1) ∧
                              (Manuscript.CutoffExecution.cutoffSearch kapMin kap A N (Real.log (CΛ / u))).operations ≤
                                10 * N + 3
Manuscript.DisorderOrthogonality.graphWeight_pair_integral.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V]
  [DecidableEq V] [Fintype E] [DecidableEq E] (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (incidence : E → Finset V) (h : ℝ) (a : E → ℝ) (Γ Γ' : Finset E) :
  ∫ (J : E → ℝ),
      Manuscript.DisorderOrthogonality.graphWeight incidence h a Γ J *
        Manuscript.DisorderOrthogonality.graphWeight incidence h a Γ' J ∂SpinGlass.Disorder.iidLaw μ =
    if Γ = Γ' then
      Real.tanh h ^ (2 * (Manuscript.FieldExpansion.boundary incidence Γ).card) *
        ∏ e ∈ Γ, SpinGlass.Disorder.secondMoment μ (a e)
    else 0
Manuscript.DisorderOrthogonality.independent_coefficients_second_moment.{u_1, u_2, u_3} {V : Type u_1} {E : Type u_2}
  {Ω : Type u_3} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E] [MeasurableSpace Ω]
  (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ] (hμ : SpinGlass.Disorder.SymmetricLaw μ)
  (P : MeasureTheory.Measure Ω) [MeasureTheory.IsProbabilityMeasure P] (incidence : E → Finset V) (h : ℝ) (a : E → ℝ)
  (A : Finset (Finset E)) (c : Ω → Finset E → ℝ) (hc : ∀ Γ ∈ A, Measurable fun ω => c ω Γ)
  (hcsq : ∀ Γ ∈ A, MeasureTheory.Integrable (fun ω => c ω Γ ^ 2) P) :
  ∫ (ωJ : Ω × (E → ℝ)),
      (∑ Γ ∈ A, c ωJ.1 Γ * Manuscript.DisorderOrthogonality.graphWeight incidence h a Γ ωJ.2) ^
        2 ∂P.prod (SpinGlass.Disorder.iidLaw μ) =
    ∑ Γ ∈ A,
      (∫ (ω : Ω), c ω Γ ^ 2 ∂P) * Real.tanh h ^ (2 * (Manuscript.FieldExpansion.boundary incidence Γ).card) *
        ∏ e ∈ Γ, SpinGlass.Disorder.secondMoment μ (a e)
Manuscript.DisorderOrthogonality.monomial_pair_integral.{u_2} {E : Type u_2} [Fintype E] [DecidableEq E]
  (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ] (hμ : SpinGlass.Disorder.SymmetricLaw μ)
  (a : E → ℝ) (Γ Γ' : Finset E) :
  ∫ (J : E → ℝ), SpinGlass.Disorder.monomial a Γ J * SpinGlass.Disorder.monomial a Γ' J ∂SpinGlass.Disorder.iidLaw μ =
    if Γ = Γ' then ∏ e ∈ Γ, SpinGlass.Disorder.secondMoment μ (a e) else 0
Manuscript.DisorderOrthogonality.physical_retained_family_error (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ] (hμ : SpinGlass.Disorder.SymmetricLaw μ) (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ)
  (beta h : ℝ) (keep : Finset (Manuscript.Model.Edge N P) → Prop) [DecidablePred keep] :
  ∫ (J : Manuscript.Model.Edge N P → ℝ),
      (Manuscript.Model.normalizedPartition N P a beta h J -
          ∑ Γ ∈ Finset.univ.powerset with keep Γ,
            Manuscript.DisorderOrthogonality.graphWeight Subtype.val h
              (Manuscript.DisorderOrthogonality.physicalScale N P a beta) Γ J) ^
        2 ∂SpinGlass.Disorder.iidLaw μ =
    ∑ Γ ∈ Finset.univ.powerset with ¬keep Γ,
      Real.tanh h ^ (2 * (Manuscript.FieldExpansion.boundary Subtype.val Γ).card) *
        ∏ e ∈ Γ, SpinGlass.Disorder.secondMoment μ (Manuscript.DisorderOrthogonality.physicalScale N P a beta e)
Manuscript.HigherFieldExponent.selectedKappa_zero (N : ℕ) (rho : ℝ) {p : ℝ} (hp : 0 < p) :
  Manuscript.HigherFieldExponent.selectedKappa N rho p 0 = (p - 2) / p
Manuscript.HigherOrderAlgorithm.mse_bound (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ)
  (a : ℕ → ℝ) (hP : P.Nonempty) (ha : ∀ p ∈ P, 0 < a p) (pmin : ℝ) (hpmin : 3 ≤ pmin) (horders : ∀ p ∈ P, pmin ≤ ↑p)
  (pmax : ℕ) (hmax : ∀ p ∈ P, p ≤ pmax) (hpN : ∀ p ∈ P, p ≤ N) {beta B h rho u : ℝ} (hbeta : 0 ≤ beta)
  (hbetaB : beta ≤ B) (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a)
  (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) (hu : 0 < u) (hu1 : u < 1) :
  ∫ (J : Manuscript.Model.Edge N P → ℝ),
      (Manuscript.Model.normalizedPartition N P a beta h J -
          (Manuscript.HigherOrderAlgorithm.run N pmax P a B rho pmin beta h u J).value) ^
        2 ∂SpinGlass.Disorder.iidLaw μ ≤
    u
Manuscript.HigherOrderCorollaries.polynomial_confidence (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty)
  (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 3 ≤ p) {B rho b : ℝ} (hB : 0 < B)
  (hBT : B < Manuscript.MixedThreshold.betaF P a) (hb : 0 < b) :
  ∃ C,
    0 < C ∧
      ∀ (μ : MeasureTheory.Measure ℝ),
        MeasureTheory.IsProbabilityMeasure μ →
          SpinGlass.Disorder.SymmetricLaw μ →
            SpinGlass.Disorder.UnitSecondMoment μ →
              ∀ (m : ℝ),
                2 * (↑(P.min' hP) + b) / (↑(P.min' hP) - 1) ≤ m →
                  MeasureTheory.Integrable (fun x => |x| ^ m) μ →
                    ∀ᶠ (N : ℕ) in Filter.atTop,
                      ∀ (beta h epsilon : ℝ),
                        0 ≤ beta →
                          beta ≤ B →
                            |h| ≤ rho * ↑N ^ (-(1 / 4)) →
                              0 < epsilon →
                                epsilon < 1 →
                                  (SpinGlass.Disorder.iidLaw μ).real
                                        {J |
                                          epsilon <
                                            |(Manuscript.HigherOrderCorollaries.confidenceExecute N P hP a B rho beta h
                                                    epsilon b J).value -
                                                Real.log (Manuscript.Model.partition N P a beta h J)|} ≤
                                      ↑N ^ (-b) ∧
                                    ∀ (J : Manuscript.Model.Edge N P → ℝ),
                                      ↑(Manuscript.HigherOrderCorollaries.confidenceExecute N P hP a B rho beta h
                                              epsilon b J).operations ≤
                                        C * ↑N ^ C * epsilon ^ (-C)
Manuscript.HigherOrderCorollaries.relative_counting (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty) (ha : ∀ p ∈ P, 0 < a p)
  (hp : ∀ p ∈ P, 3 ≤ p) {B rho : ℝ} (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a) :
  ∃ C,
    0 < C ∧
      ∀ (μ : MeasureTheory.Measure ℝ),
        MeasureTheory.IsProbabilityMeasure μ →
          SpinGlass.Disorder.SymmetricLaw μ →
            SpinGlass.Disorder.UnitSecondMoment μ →
              ∀ (N : ℕ),
                P.max' hP ≤ N →
                  ∀ (beta h epsilon : ℝ),
                    0 ≤ beta →
                      beta ≤ B →
                        |h| ≤ rho * ↑N ^ (-(1 / 4)) →
                          0 < epsilon →
                            epsilon < 1 →
                              1 -
                                      Manuscript.OriginalLawLowerTail.tau μ N P a B
                                        (Manuscript.MixedThreshold.theta P a B) -
                                    Manuscript.CountingConsequences.confidence N 1 ≤
                                  (SpinGlass.Disorder.iidLaw μ).real
                                    {J |
                                      1 - epsilon ≤
                                          (Manuscript.HigherOrderCorollaries.relativeExecute N P hP a B rho beta h
                                                epsilon J).value /
                                            Manuscript.Model.partition N P a beta h J ∧
                                        (Manuscript.HigherOrderCorollaries.relativeExecute N P hP a B rho beta h epsilon
                                                J).value /
                                            Manuscript.Model.partition N P a beta h J ≤
                                          1 + epsilon} ∧
                                ∀ (J : Manuscript.Model.Edge N P → ℝ),
                                  0 <
                                      (Manuscript.HigherOrderCorollaries.relativeExecute N P hP a B rho beta h epsilon
                                          J).value ∧
                                    ↑(Manuscript.HigherOrderCorollaries.relativeExecute N P hP a B rho beta h epsilon
                                            J).operations ≤
                                      C * ↑N ^ C * epsilon ^ (-C)
Manuscript.HigherOrderTail.physical_support_tail (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ)
  (a : ℕ → ℝ) (hP : P.Nonempty) (ha : ∀ p ∈ P, 0 < a p) (pmin : ℝ) (hpmin : 3 ≤ pmin) (horders : ∀ p ∈ P, pmin ≤ ↑p)
  (pmax : ℕ) (hmax : ∀ p ∈ P, p ≤ pmax) (hpN : ∀ p ∈ P, p ≤ N) {beta B h rho alpha : ℝ} (hbeta : 0 ≤ beta)
  (hbetaB : beta ≤ B) (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a)
  (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) (halpha : 1 / 4 ≤ alpha)
  (hfieldAlpha : |Real.tanh h| ≤ max 1 rho * ↑N ^ (-alpha)) (k : ℕ)
  (hcut :
    k <
      ⌊Manuscript.Cutoffs.gamma (Manuscript.SupportExponent.kappaMin pmin)
            (Manuscript.HigherOrderTail.scale P a B rho pmin) *
          ↑N⌋₊) :
  ∫ (J : Manuscript.Model.Edge N P → ℝ),
      (Manuscript.Model.normalizedPartition N P a beta h J -
          (Manuscript.HigherOrderTail.evaluator N P a beta h k J).value) ^
        2 ∂SpinGlass.Disorder.iidLaw μ ≤
    2 *
        Real.exp
          (-SpinGlass.CutoffTail.phi (Manuscript.SupportExponent.kappa pmin alpha)
              (Manuscript.HigherOrderTail.scale P a B rho pmin) (↑N) (↑k + 1)) +
      Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho *
        Real.exp (-Manuscript.HigherOrderTail.c1 P a B rho pmin pmax * ↑N)
Manuscript.Model.normalizedPartition_eq_graph_sum (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ) (beta h : ℝ)
  (J : Manuscript.Model.Edge N P → ℝ) :
  Manuscript.Model.normalizedPartition N P a beta h J =
    ∑ Γ ∈ Finset.univ.powerset,
      Manuscript.FieldExpansion.graphWeight Subtype.val h
        (fun e => Real.tanh (Manuscript.Model.coefficient N P a beta J e)) Γ
