Manuscript.RestrictedCutoff.program_exec (params : Manuscript.RestrictedMachine.Parameters)
  (input : Manuscript.RestrictedMachine.Inputs) (s : Manuscript.RestrictedMachine.State) (kapMin kap A Lambda : ℝ)
  (N : ℕ) (hA : 0 < A) (hn : s.natReg 0 = N) (hk : s.realReg 1 = kap) (ha : s.realReg 2 = A) (hl : s.realReg 3 = Lambda)
  (hg : s.realReg 4 = Manuscript.Cutoffs.gamma kapMin A) :
  ∃ cost final,
    Manuscript.RestrictedMachine.Exec params input Manuscript.RestrictedCutoff.program s cost final ∧
      cost ≤ 78 * N + 65 ∧
        final.natReg 20 = (Manuscript.CutoffExecution.cutoffSearch kapMin kap A N Lambda).found.getD 1 - 1 ∧
          final.realMem = s.realMem ∧ final.natMem = s.natMem
Manuscript.RestrictedHigherEndpoint.program_exec {N M : ℕ} (hN : 0 < N) (pmax : ℕ) (P : Finset ℕ) (a : ℕ → ℝ)
  (hmax : ∀ p ∈ P, p ≤ pmax) (B rho pmin beta h epsilon delta : ℝ) (order : Fin M ≃ Manuscript.Model.Edge N P)
  (J : Manuscript.Model.Edge N P → ℝ) (tape : ℕ → ℕ) :
  ∃ count final,
    Manuscript.RestrictedRecursiveMachine.Exec Manuscript.RestrictedHigherLayer.table
        (Manuscript.RestrictedParameters.higher pmax P a B rho pmin)
        (Manuscript.RestrictedInputEncoding.encode order beta h epsilon delta J tape)
        (Manuscript.RestrictedHigherEndpoint.program pmax P a B rho pmin) Manuscript.RestrictedMachine.initial count
        final ∧
      final.realReg 3 = (Manuscript.HigherOrderFinal.execute N pmax P a B rho pmin beta h epsilon delta J).value ∧
        count ≤
          141 * M + 78 * N + 461 +
            (59 * N + 26 + (66 * N + 56) * M + 300 * (N + 1) + 400) *
              ∑ l ∈ Finset.range (Manuscript.RestrictedHigherEndpoint.cutoff N pmax P a B rho pmin h epsilon delta + 1),
                N.choose l * 2 ^ l
Manuscript.RestrictedHigherFinal.end_to_end (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty) (ha : ∀ p ∈ P, 0 < a p)
  (pmin : ℝ) (hpmin : 3 ≤ pmin) (horders : ∀ p ∈ P, pmin ≤ ↑p) (pmax : ℕ) (hmax : ∀ p ∈ P, p ≤ pmax) {B rho : ℝ}
  (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a) :
