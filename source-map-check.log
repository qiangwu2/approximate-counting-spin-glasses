      ∀ (μ : MeasureTheory.Measure ℝ),
        MeasureTheory.IsProbabilityMeasure μ →
          SpinGlass.Disorder.SymmetricLaw μ →
            SpinGlass.Disorder.UnitSecondMoment μ →
              ∀ (N M : ℕ),
                (∀ p ∈ P, p ≤ N) →
                  ∀ (beta h epsilon delta : ℝ),
                    0 ≤ beta →
                      beta ≤ B →
                        |h| ≤ rho * ↑N ^ (-(1 / 4)) →
                          0 < epsilon →
                            epsilon < 1 →
                              0 < delta →
                                delta < 1 →
                                  ∀ (order : Fin M ≃ Manuscript.Model.Edge N P) (tape : ℕ → ℕ),
                                    (SpinGlass.Disorder.iidLaw μ).real
                                          {J |
                                            epsilon <
                                              |(Manuscript.HigherOrderFinal.execute N pmax P a B rho pmin beta h epsilon
                                                      delta J).value -
                                                  Real.log (Manuscript.Model.partition N P a beta h J)|} ≤
                                        delta +
                                          Manuscript.OriginalLawLowerTail.tau μ N P a B
                                            (Manuscript.MixedThreshold.theta P a B) ∧
                                      ∀ (J : Manuscript.Model.Edge N P → ℝ),
                                        ∃ count final,
