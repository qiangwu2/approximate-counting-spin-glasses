      (Manuscript.SKAlgorithm.run N a B rho beta h u χJ.1 χJ.2 -
          Manuscript.Model.normalizedPartition N {2} a beta h χJ.2) ^
        2 ∂(Manuscript.SKAlgorithm.colorLaw N a B rho u).prod (SpinGlass.Disorder.iidLaw μ) ≤
    u
Manuscript.SKAugmentFinset.augment_erase.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (Δ : Finset (Finset (Option V))) (hΔ : ∀ e ∈ Δ, e.card = 2)
  (heven : ∀ (v : V), Even (SpinGlass.Expansion.degree id Δ (some v))) :
  Manuscript.SKAugmentFinset.augment (Manuscript.SKAugmentFinset.erase Δ) = Δ
Manuscript.SKBranching.branchCard_mass_bound.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (b : ℕ) (hb : 0 < b)
  {B F φ r : ℝ} (hN : 0 < Fintype.card V) (hB : 0 ≤ B) (hB1 : B < 1) (hF : 0 ≤ F) (hφ : 0 ≤ φ) (hr : 0 ≤ r)
  (hNr : ↑(Fintype.card V) * r ≤ B ^ 2) (hφN : φ * √↑(Fintype.card V) ≤ F) :
  ∑ Γ ∈ Manuscript.SKBranching.branchCardFamily b, φ ^ (Manuscript.FieldExpansion.boundary id Γ).card * r ^ Γ.card ≤
    Manuscript.SKBranching.massConstant B F * (Manuscript.SKBranching.branchConstant B F * ↑b / ↑(Fintype.card V)) ^ b
Manuscript.SKCandidateCoefficientOutput.candidate_exec.{u_1} {V : Type u_1} [DecidableEq V]
  (p : Manuscript.RestrictedMachine.Parameters) (i : Manuscript.RestrictedMachine.Inputs)
  (d : Manuscript.SKCandidateLayout.Layout) (hK : 1 ≤ d.root.K) (q : Fin d.root.B → ℕ) (branch : Fin d.root.B → V)
  (outside : Fin d.root.N → V) (χ : Fin d.root.N → Fin d.root.K) (f : Finset V → ℝ)
  (s : Manuscript.RestrictedMachine.State)
  (hs :
    Manuscript.SKRootCache.InputsReady d.root χ
      (fun x y => SpinGlass.SKFastEvaluator.pairWeight f (outside x) (outside y))
      (fun x y => SpinGlass.SKFastEvaluator.pairWeight f (branch x) (outside y)) s)
  (hl : Manuscript.SKCandidateLayout.Inputs d s) (hq : ∀ (x : Fin d.root.B), s.natMem (d.chargeBase + ↑x) = q x)
  (hw :
    ∀ (a c : Fin d.root.B),
      s.realMem (d.branchWeightBase + ↑a * d.root.B + ↑c) =
        SpinGlass.SKFastEvaluator.pairWeight f (branch a) (branch c)) :
  ∃ count t,
    Manuscript.RestrictedMachine.Exec p i Manuscript.SKRestrictedCandidateExecution.program s count t ∧
      count ≤ Manuscript.SKRestrictedCandidateExecution.operationBound d ∧
        t.realReg 310 =
            (Manuscript.SKChargedTrialExecution.trial q branch outside χ f d.retained
                (Manuscript.SKExtractionCell.accepted d.ghost)).value ∧
          Manuscript.SKRestrictedArrays.Represents d.base (Manuscript.SKChargedExecution.evaluate q branch outside χ f)
              t.realMem ∧
            (∀ address < d.root.arena, t.realMem address = s.realMem address) ∧
              (∀ address < d.metadataBase, t.natMem address = s.natMem address) ∧
                (∀ (r : ℕ), 500 ≤ r → t.natReg r = s.natReg r) ∧ ∀ (r : ℕ), 500 ≤ r → t.realReg r = s.realReg r
Manuscript.SKChargeProjection.manuscript_array_size (b L : ℕ) :
  Fintype.card (Manuscript.SKChargeProjection.RetainedBasis (b + 1) L (2 * L)) = (L + 1) * 4 ^ L * 6 ^ (b + 1)
Manuscript.SKChargeProjection.projectedAlgorithm_eq_disorder.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (D L R : ℕ) (hL : 0 < L) (χ : Manuscript.SKColorEstimator.Colors V L R) (h : ℝ) (a J : Finset V → ℝ) :
  (Manuscript.SKChargeProjection.projectedAlgorithm D L R χ h fun e => Real.tanh (a e * J e)) =
    Manuscript.SKColorEstimator.estimator id (Finset.powersetCard 2 Finset.univ) D L R h a χ J
Manuscript.SKChargeProjection.projectedAlgorithm_eq_generated.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (D L R : ℕ) (χ : Manuscript.SKColorEstimator.Colors V L R) (h : ℝ) (w : Finset V → ℝ) :
  Manuscript.SKChargeProjection.projectedAlgorithm D L R χ h w =
    (Manuscript.SKGeneratedExecution.estimator D L R χ (Real.tanh h) w).value
Manuscript.SKColorEstimator.coloring_mse_le.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [Fintype E] [DecidableEq E] (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (incidence : E → Finset V) (edges : Finset E) (D : ℕ) {L R : ℕ} (hL : 0 < L)
  (hR : 0 < R) (hp : ∀ e ∈ edges, (incidence e).card = 2) (h : ℝ) (a : E → ℝ) :
  ∫ (χJ : Manuscript.SKColorEstimator.Colors V L R × (E → ℝ)),
      (Manuscript.SKColorEstimator.estimator incidence edges D L R h a χJ.1 χJ.2 -
          Manuscript.SKColorEstimator.retainedSum incidence edges D L h a χJ.2) ^
        2 ∂(Manuscript.SKColorEstimator.colorLaw V L R).prod (SpinGlass.Disorder.iidLaw μ) ≤
    Real.exp (2 * ↑L) / ↑R * ∑ Γ ∈ edges.powerset, Manuscript.SKColorEstimator.graphMass μ incidence h a Γ
Manuscript.SKColorEstimator.partition_mse_eq.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [Fintype E] [DecidableEq E] (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (incidence : E → Finset V) (edges : Finset E) (D : ℕ) {L R : ℕ} (hL : 0 < L)
  (hR : 0 < R) (hp : ∀ e ∈ edges, (incidence e).card = 2) (h : ℝ) (a : E → ℝ) :
  ∫ (χJ : Manuscript.SKColorEstimator.Colors V L R × (E → ℝ)),
      (Manuscript.SKColorEstimator.estimator incidence edges D L R h a χJ.1 χJ.2 -
          Manuscript.FieldExpansion.normalizedPartition incidence edges h fun e => a e * χJ.2 e) ^
        2 ∂(Manuscript.SKColorEstimator.colorLaw V L R).prod (SpinGlass.Disorder.iidLaw μ) =
    ∫ (χJ : Manuscript.SKColorEstimator.Colors V L R × (E → ℝ)),
        (Manuscript.SKColorEstimator.estimator incidence edges D L R h a χJ.1 χJ.2 -
            Manuscript.SKColorEstimator.retainedSum incidence edges D L h a χJ.2) ^
          2 ∂(Manuscript.SKColorEstimator.colorLaw V L R).prod (SpinGlass.Disorder.iidLaw μ) +
      ∑ Γ ∈ edges.powerset with ¬Manuscript.SKGraph.Retained incidence D L Γ,
        Manuscript.SKColorEstimator.graphMass μ incidence h a Γ
Manuscript.SKColorEstimator.partition_mse_le.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [Fintype E] [DecidableEq E] (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (incidence : E → Finset V) (edges : Finset E) (D : ℕ) {L R : ℕ} (hL : 0 < L)
  (hR : 0 < R) (hp : ∀ e ∈ edges, (incidence e).card = 2) (h : ℝ) (a : E → ℝ) :
  ∫ (χJ : Manuscript.SKColorEstimator.Colors V L R × (E → ℝ)),
      (Manuscript.SKColorEstimator.estimator incidence edges D L R h a χJ.1 χJ.2 -
          Manuscript.FieldExpansion.normalizedPartition incidence edges h fun e => a e * χJ.2 e) ^
        2 ∂(Manuscript.SKColorEstimator.colorLaw V L R).prod (SpinGlass.Disorder.iidLaw μ) ≤
    Real.exp (2 * ↑L) / ↑R * ∑ Γ ∈ edges.powerset, Manuscript.SKColorEstimator.graphMass μ incidence h a Γ +
      ∑ Γ ∈ edges.powerset with ¬Manuscript.SKGraph.Retained incidence D L Γ,
        Manuscript.SKColorEstimator.graphMass μ incidence h a Γ
Manuscript.SKColorfulCoefficientOutput.end_to_end {N : ℕ} (p : Manuscript.RestrictedMachine.Parameters)
  (input : Manuscript.RestrictedMachine.Inputs) (d : Manuscript.SKCandidateLayout.Layout) (L : ℕ) (hL : 1 ≤ L)
  (hK : d.root.K = 2 * L) (A : Finset (Fin N)) (hn : d.root.N ≤ N) (hbcard : d.root.B = A.card + 1)
  (lab : Fin d.root.B → Option (Fin N)) (out : Fin d.root.N → Option (Fin N)) (hb : Function.Injective lab)
  (ho : Function.Injective out)
  (hbr : ∀ (v : Option (Fin N)), v ∈ Manuscript.SKGhostAdmissible.distinguished A ↔ ∃ j, lab j = v)
  (hor : ∀ (v : Option (Fin N)), v ∉ Manuscript.SKGhostAdmissible.distinguished A ↔ ∃ j, out j = v)
  (hg : lab d.ghost = none) (χ : Fin N → Fin d.root.K) (h : ℝ) (w : Finset (Fin N) → ℝ)
  (s : Manuscript.RestrictedMachine.State)
  (hs :
    Manuscript.SKRootCache.InputsReady d.root (Manuscript.SKColorfulCoefficientOutput.extendColor ⋯ χ ∘ out)
      (fun x y => SpinGlass.SKFastEvaluator.pairWeight (Manuscript.SKAugmentFinset.edgeWeight h w) (out x) (out y))
      (fun x y => SpinGlass.SKFastEvaluator.pairWeight (Manuscript.SKAugmentFinset.edgeWeight h w) (lab x) (out y)) s)
  (hl : Manuscript.SKCandidateLayout.Inputs d s)
  (hq : ∀ (x : Fin d.root.B), s.natMem (d.chargeBase + ↑x) = if lab x = none then 0 else 1)
  (hw :
    ∀ (a c : Fin d.root.B),
      s.realMem (d.branchWeightBase + ↑a * d.root.B + ↑c) =
        SpinGlass.SKFastEvaluator.pairWeight (Manuscript.SKAugmentFinset.edgeWeight h w) (lab a) (lab c)) :
  ∃ count t,
    Manuscript.RestrictedMachine.Exec p input Manuscript.SKRestrictedCandidateExecution.program s count t ∧
      count ≤ 360000 * (N + 2 * L + 1) ^ 6 * 16 ^ L * 36 ^ A.card ∧
        ∀ (k : Fin (d.root.K + 1)) (S : Finset (Fin d.root.K)),
          Manuscript.SKColorfulCoefficientOutput.readout d.base d.ghost t.realMem k S =
            ∑ Γ ∈ Manuscript.SKBranching.branchFamily A,
              if
                  Γ.card = ↑k ∧
                    Finset.image χ (Manuscript.SKGraph.outside id Γ) = S ∧
                      Set.InjOn χ ↑(Manuscript.SKGraph.outside id Γ) then
                Manuscript.FieldExpansion.graphWeight id h w Γ
              else 0
Manuscript.SKCorollaries.polynomial_confidence (a : ℕ → ℝ) (ha : a 2 = 1) {B rho b : ℝ} (hB : 0 < B) (hB1 : B < 1)
  (hb : 0 < b) :
  ∃ C,
    0 < C ∧
      ∀ (μ : MeasureTheory.Measure ℝ),
        MeasureTheory.IsProbabilityMeasure μ →
          SpinGlass.Disorder.SymmetricLaw μ →
            SpinGlass.Disorder.UnitSecondMoment μ →
              ∀ (m : ℝ),
                4 + 2 * b ≤ m →
                  MeasureTheory.Integrable (fun x => |x| ^ m) μ →
                    ∀ᶠ (N : ℕ) in Filter.atTop,
                      ∃ (hN : 2 ≤ N),
                        ∀ (beta h epsilon : ℝ),
                          0 ≤ beta →
                            beta ≤ B →
                              |h| ≤ rho * ↑N ^ (-(1 / 4)) →
                                0 < epsilon →
                                  epsilon < 1 →
                                    ((Manuscript.SKTheorem.colorLaw N a B rho epsilon
                                                  (Manuscript.CountingConsequences.confidence N b)).prod
                                              (SpinGlass.Disorder.iidLaw μ)).real
                                          {χJ |
                                            epsilon <
                                              |(Manuscript.SKCorollaries.confidenceExecute N ⋯ a B rho beta h epsilon b
                                                      ⋯ ⋯ χJ.1 χJ.2).value -
                                                  Real.log (Manuscript.Model.partition N {2} a beta h χJ.2)|} ≤
                                        ↑N ^ (-b) ∧
                                      ∀ (χ : Manuscript.SKCorollaries.ConfidenceColors N a B rho epsilon b)
                                        (J : Manuscript.Model.Edge N {2} → ℝ),
                                        ↑(Manuscript.SKCorollaries.confidenceExecute N ⋯ a B rho beta h epsilon b ⋯ ⋯ χ
                                                J).operations ≤
                                          C * ↑N ^ C * epsilon ^ (-C)
Manuscript.SKCorollaries.relative_counting (a : ℕ → ℝ) (ha : a 2 = 1) {B rho : ℝ} (hB : 0 < B) (hB1 : B < 1) :
  ∃ C,
    0 < C ∧
      ∀ (μ : MeasureTheory.Measure ℝ),
        MeasureTheory.IsProbabilityMeasure μ →
          SpinGlass.Disorder.SymmetricLaw μ →
            SpinGlass.Disorder.UnitSecondMoment μ →
              ∀ (N : ℕ) (hN : 2 ≤ N) (beta h epsilon : ℝ),
                0 ≤ beta →
                  beta ≤ B →
                    |h| ≤ rho * ↑N ^ (-(1 / 4)) →
                      0 < epsilon →
                        epsilon < 1 →
                          1 -
                                  Manuscript.OriginalLawLowerTail.tau μ N {2} a B
                                    (Manuscript.MixedThreshold.theta {2} a B) -
                                Manuscript.CountingConsequences.confidence N 1 ≤
                              ((Manuscript.SKTheorem.colorLaw N a B rho
                                        (Manuscript.CountingConsequences.relativeTolerance epsilon)
                                        (Manuscript.CountingConsequences.confidence N 1)).prod
                                    (SpinGlass.Disorder.iidLaw μ)).real
                                {χJ |
                                  1 - epsilon ≤
                                      (Manuscript.SKCorollaries.relativeExecute N ⋯ a B rho beta h epsilon ⋯ χJ.1
                                            χJ.2).value /
                                        Manuscript.Model.partition N {2} a beta h χJ.2 ∧
                                    (Manuscript.SKCorollaries.relativeExecute N ⋯ a B rho beta h epsilon ⋯ χJ.1
                                            χJ.2).value /
                                        Manuscript.Model.partition N {2} a beta h χJ.2 ≤
                                      1 + epsilon} ∧
                            ∀ (χ : Manuscript.SKCorollaries.RelativeColors N a B rho epsilon)
                              (J : Manuscript.Model.Edge N {2} → ℝ),
                              0 < (Manuscript.SKCorollaries.relativeExecute N ⋯ a B rho beta h epsilon ⋯ χ J).value ∧
                                ↑(Manuscript.SKCorollaries.relativeExecute N ⋯ a B rho beta h epsilon ⋯ χ
                                        J).operations ≤
                                  C * ↑N ^ C * epsilon ^ (-C)
Manuscript.SKGhostAdmissible.admissible_iff.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] (A : Finset V)
  (Δ : Finset (Finset (Option V))) :
  Manuscript.SKGhostAdmissible.Admissible A Δ ↔
    ∃ Γ ∈ Manuscript.SKBranching.branchFamily A, Manuscript.SKAugmentFinset.augment Γ = Δ
Manuscript.SKGhostCoefficient.algorithm_eq_physical (N D L R : ℕ) (hL : 0 < L)
  (χ : Manuscript.SKColorEstimator.Colors (Fin N) L R) (a : ℕ → ℝ) (beta h : ℝ) (J : Manuscript.Model.Edge N {2} → ℝ) :
  Manuscript.SKGhostCoefficient.algorithm D L R χ h (Manuscript.SKGhostCoefficient.inputWeight N a beta J) =
    Manuscript.SKColorEstimator.estimator Subtype.val Finset.univ D L R h
      (Manuscript.DisorderOrthogonality.physicalScale N {2} a beta) χ J
Manuscript.SKGhostCoefficient.coefficient_original.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V] {K : ℕ}
  (A : Finset V) (χ : V → Fin K) (hK : 0 < K) (h : ℝ) (w : Finset V → ℝ) (k : Fin (K + 1)) (S : Finset (Fin K)) :
  ∑ d ∈ Manuscript.SKGhostAdmissible.accepted A,
      Manuscript.SKGhostCoefficient.evaluate A χ h w (Manuscript.SKChargedMonomial.target k S d) =
    ∑ Γ ∈ Manuscript.SKBranching.branchFamily A,
      if
          Γ.card = ↑k ∧
            Finset.image χ (Manuscript.SKGraph.outside id Γ) = S ∧ Set.InjOn χ ↑(Manuscript.SKGraph.outside id Γ) then
        Manuscript.FieldExpansion.graphWeight id h w Γ
      else 0
Manuscript.SKPhysicalEstimator.coloring_mse (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (hunit : SpinGlass.Disorder.UnitSecondMoment μ) {N D L R : ℕ} (hN : 2 ≤ N)
  (hL : 0 < L) (hR : 0 < R) (a : ℕ → ℝ) (ha : a 2 = 1) {beta B h rho : ℝ} (hb : 0 ≤ beta) (hbB : beta ≤ B) (hB : 0 < B)
  (hB1 : B < 1) (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) :
  ∫ (χJ : Manuscript.SKColorEstimator.Colors (Fin N) L R × (Manuscript.Model.Edge N {2} → ℝ)),
      (Manuscript.SKPhysicalEstimator.value N D L R a beta h χJ.1 χJ.2 -
          Manuscript.SKPhysicalModel.truncation N D L a beta h χJ.2) ^
        2 ∂(Manuscript.SKColorEstimator.colorLaw (Fin N) L R).prod (SpinGlass.Disorder.iidLaw μ) ≤
    Manuscript.UniformMixedMass.massConstant {2} a (Manuscript.MixedThreshold.betaPlus {2} a B ^ 2) rho *
        Real.exp (2 * ↑L) /
      ↑R
Manuscript.SKPhysicalEstimator.unbiased (N D L R : ℕ) (hL : 0 < L) (hR : 0 < R) (a : ℕ → ℝ) (beta h : ℝ)
  (J : Manuscript.Model.Edge N {2} → ℝ) :
  ∫ (χ : Manuscript.SKColorEstimator.Colors (Fin N) L R),
      Manuscript.SKPhysicalEstimator.value N D L R a beta h χ J ∂Manuscript.SKColorEstimator.colorLaw (Fin N) L R =
    Manuscript.SKPhysicalModel.truncation N D L a beta h J
Manuscript.SKPhysicalEstimator.value_eq (N D L R : ℕ) (hL : 0 < L) (a : ℕ → ℝ) (beta h : ℝ)
  (χ : Manuscript.SKColorEstimator.Colors (Fin N) L R) (J : Manuscript.Model.Edge N {2} → ℝ) :
  Manuscript.SKPhysicalEstimator.value N D L R a beta h χ J =
    Manuscript.SKColorEstimator.estimator Subtype.val Finset.univ D L R h
      (Manuscript.DisorderOrthogonality.physicalScale N {2} a beta) χ J
Manuscript.SKPhysicalModel.truncation_mse (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (hunit : SpinGlass.Disorder.UnitSecondMoment μ) {N D L : ℕ} (hN : 2 ≤ N)
  (a : ℕ → ℝ) (ha : a 2 = 1) {beta B Bplus h rho C alpha : ℝ} (hbeta : 0 ≤ beta) (hbetaB : beta ≤ B) (hB : 0 < B)
  (hBplus : B < Bplus) (hplus1 : Bplus < 1) (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) (hC : 0 < C)
  (hBC : Manuscript.SKBranching.branchConstant B (rho ^ 2) ≤ C) (halpha : 0 < alpha)
  (hgap : 2 ≤ Real.log (1 / (C * alpha)) - 1) (hcut : D < ⌊alpha * ↑N⌋₊) :
  ∫ (J : Manuscript.Model.Edge N {2} → ℝ),
      (Manuscript.Model.normalizedPartition N {2} a beta h J - Manuscript.SKPhysicalModel.truncation N D L a beta h J) ^
        2 ∂SpinGlass.Disorder.iidLaw μ ≤
    Manuscript.UniformMixedMass.massConstant {2} (fun x => 1) (Bplus ^ 2) rho * ((B / Bplus) ^ 2) ^ (L + 1) +
        2 * Manuscript.SKBranching.massConstant B (rho ^ 2) * Real.exp (-SpinGlass.CutoffTail.phi 1 C (↑N) (↑D + 1)) +
      Manuscript.UniformMixedMass.massConstant {2} (fun x => 1) (Bplus ^ 2) rho *
        ((B / Bplus) ^ 2) ^ (3 * alpha * ↑N / 2)
Manuscript.SKProjectedOutput.accuracy (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hμ : SpinGlass.Disorder.SymmetricLaw μ) (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (hN : 2 ≤ N)
  (a : ℕ → ℝ) (ha : a 2 = 1) {beta B h rho epsilon delta : ℝ} (hbeta : 0 ≤ beta) (hbetaB : beta ≤ B) (hB : 0 < B)
  (hB1 : B < 1) (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) (he : 0 < epsilon) (he1 : epsilon < 1) (hd : 0 < delta)
  (hd1 : delta < 1) :
  ((Manuscript.SKTheorem.colorLaw N a B rho epsilon delta).prod (SpinGlass.Disorder.iidLaw μ)).real
      {χJ |
        epsilon <
          |Manuscript.SKProjectedOutput.output N a B rho beta h epsilon delta ⋯ hd χJ.1 χJ.2 -
              Real.log (Manuscript.Model.partition N {2} a beta h χJ.2)|} ≤
    delta + Manuscript.OriginalLawLowerTail.tau μ N {2} a B (Manuscript.MixedThreshold.theta {2} a B)
Manuscript.SKProjectedOutput.output_eq_execute (N : ℕ) (a : ℕ → ℝ) (B rho beta h epsilon delta : ℝ)
  (hC : 0 < Manuscript.LogApprox.constant {2} a B rho) (hd : 0 < delta)
  (χ : Manuscript.SKTheorem.Colors N a B rho epsilon delta) (J : Manuscript.Model.Edge N {2} → ℝ) :
  Manuscript.SKProjectedOutput.output N a B rho beta h epsilon delta hC hd χ J =
    (Manuscript.SKFinal.execute N a B rho beta h epsilon delta hC hd χ J).value
Manuscript.SKRawCandidate.encoded_program_exec {N M L R : ℕ} (params : Manuscript.RestrictedMachine.Parameters)
  (order : Fin M ≃ Manuscript.Model.Edge N {2}) (aCoeff : ℕ → ℝ) (beta h epsilon delta : ℝ)
  (J : Manuscript.Model.Edge N {2} → ℝ) (χ : Manuscript.SKColorEstimator.Colors (Fin N) L R)
  (s : Manuscript.RestrictedMachine.State) (A : Finset (Fin N)) (r : Fin R) (hL : 0 < L) (hret : s.natReg 512 = L)
  (hA : s.natReg 520 = Manuscript.RestrictedMaskBridge.encode A)
  (hptr : s.natReg 522 = 2 * M + 2 + (Manuscript.RestrictedMaskBridge.encode A * R + ↑r) * N)
  (hphysical : Manuscript.SKCandidateSource.PhysicalData order aCoeff beta h J s) (hmaskFit : M ≤ s.natReg 530)
  (hlayout : Manuscript.RestrictedCandidateLabelPreparation.Layout s) :
  ∃ count t,
    Manuscript.RestrictedMachine.Exec params
        (Manuscript.RestrictedInputEncoding.encode order beta h epsilon delta J (Manuscript.SKRawColorTape.encode χ))
        Manuscript.SKRawCandidate.program s count t ∧
      count ≤ Manuscript.SKRawCandidate.operationBound s A ∧
        t.realReg 310 =
            (Manuscript.SKGeneratedExecution.trial L A (χ A r) (Real.tanh h)
                (Manuscript.SKGhostCoefficient.inputWeight N aCoeff beta J)).value ∧
          (∀ address < s.natReg 530, t.natMem address = s.natMem address) ∧
            (∀ address < 2 * s.natReg 501, t.realMem address = s.realMem address) ∧
              (∀ (r : ℕ), 500 ≤ r → r < 540 ∨ 550 ≤ r → t.natReg r = s.natReg r) ∧
                ∀ (r : ℕ), 500 ≤ r → t.realReg r = s.realReg r
Manuscript.SKRestrictedCandidateExecution.program_exec.{u_1} {V : Type u_1} [DecidableEq V]
  (p : Manuscript.RestrictedMachine.Parameters) (i : Manuscript.RestrictedMachine.Inputs)
  (d : Manuscript.SKCandidateLayout.Layout) (hK : 1 ≤ d.root.K) (q : Fin d.root.B → ℕ) (branch : Fin d.root.B → V)
  (outside : Fin d.root.N → V) (χ : Fin d.root.N → Fin d.root.K) (f : Finset V → ℝ)
  (s : Manuscript.RestrictedMachine.State)
  (hs :
    Manuscript.SKRootCache.InputsReady d.root χ
      (fun x y => SpinGlass.SKFastEvaluator.pairWeight f (outside x) (outside y))
      (fun x y => SpinGlass.SKFastEvaluator.pairWeight f (branch x) (outside y)) s)
  (hl : Manuscript.SKCandidateLayout.Inputs d s) (hq : ∀ (x : Fin d.root.B), s.natMem (d.chargeBase + ↑x) = q x)
  (hw :
    ∀ (a c : Fin d.root.B),
      s.realMem (d.branchWeightBase + ↑a * d.root.B + ↑c) =
        SpinGlass.SKFastEvaluator.pairWeight f (branch a) (branch c)) :
  ∃ count t,
    Manuscript.RestrictedMachine.Exec p i Manuscript.SKRestrictedCandidateExecution.program s count t ∧
      count ≤ Manuscript.SKRestrictedCandidateExecution.operationBound d ∧
        t.realReg 310 =
            (Manuscript.SKChargedTrialExecution.trial q branch outside χ f d.retained
                (Manuscript.SKExtractionCell.accepted d.ghost)).value ∧
          (∀ address < d.root.arena, t.realMem address = s.realMem address) ∧
            (∀ address < d.metadataBase, t.natMem address = s.natMem address) ∧
              (∀ (r : ℕ), 500 ≤ r → t.natReg r = s.natReg r) ∧ ∀ (r : ℕ), 500 ≤ r → t.realReg r = s.realReg r
Manuscript.SKRestrictedCandidateSharpCost.candidate_bound (d : Manuscript.SKCandidateLayout.Layout) (N L b : ℕ)
  (hn : d.root.N ≤ N) (hb : d.root.B = b + 1) (hbn : b ≤ N) (hK : d.root.K = 2 * L) :
  Manuscript.SKRestrictedCandidateExecution.operationBound d ≤ 360000 * (N + 2 * L + 1) ^ 6 * 16 ^ L * 36 ^ b
Manuscript.SKRestrictedCandidateSharpCost.raw_candidate_bound {N M : ℕ} (order : Fin M ≃ Manuscript.Model.Edge N {2})
  (s : Manuscript.RestrictedMachine.State) (hM : s.natReg 501 = M) (A : Finset (Fin N)) :
  Manuscript.SKRawCandidate.operationBound s A ≤
    361000 * (N + 2 * s.natReg 512 + 1) ^ 6 * 16 ^ s.natReg 512 * 36 ^ A.card
Manuscript.SupportDisorder.secondMoment_physical_le_bound (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ] (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ)
  (a : ℕ → ℝ) {beta B : ℝ} (hbeta : 0 ≤ beta) (hbetaB : beta ≤ B) (e : Manuscript.Model.Edge N P) (hp : 0 < (↑e).card) :
  SpinGlass.Disorder.secondMoment μ (Manuscript.DisorderOrthogonality.physicalScale N P a beta e) ≤
    B ^ 2 * a (↑e).card ^ 2 / ↑N ^ ((↑e).card - 1)
Manuscript.SupportEvaluation.collapsed_local_sum.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [DecidableEq E] (incidence : E → Finset V) (edges : Finset E) (h : ℝ) (w : E → ℝ) (k : ℕ) (hk : k < Fintype.card V) :
  ∑ S ∈ Finset.univ.powerset with S.card ≤ k,
      Manuscript.SupportEvaluation.coefficient (Fintype.card V) k S.card *
        Manuscript.SupportEvaluation.localG incidence edges h w S =
    ∑ Γ ∈ edges.powerset with (Manuscript.SupportEvaluation.support incidence Γ).card ≤ k,
      Manuscript.FieldExpansion.graphWeight incidence h w Γ
Manuscript.SupportExecution.supportSum_cost.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [DecidableEq E] (incidence : E → Finset V) (edges : Finset E) (b : Bool → ℝ) (w : E → ℝ) {k : ℕ}
  (hk : k ≤ Fintype.card V) :
  (Manuscript.SupportExecution.supportSum incidence edges b w k).operations ≤
    Manuscript.SupportExecution.layerConstant (Fintype.card V) edges.card *
      ∑ s ∈ Finset.range (k + 1), (Fintype.card V).choose s * 2 ^ s
Manuscript.SupportExponent.kappa_eq_zero_field (p alpha : ℝ) (hp : 0 < p) (ha : (p - 1) / (2 * p) ≤ alpha) :
  Manuscript.SupportExponent.kappa p alpha = (p - 2) / p
Manuscript.SupportMassBound.physical_supportMass_bound (N v : ℕ) (P : Finset ℕ) (pmin : ℝ) (hpmin : 3 ≤ pmin)
  (horders : ∀ p ∈ P, pmin ≤ ↑p) (hv : 0 < v) (hvN : v ≤ N) (h rho alpha : ℝ) (hrho : 1 ≤ rho) (ha : 1 / 4 ≤ alpha)
  (hfield : |Real.tanh h| ≤ rho * ↑N ^ (-alpha)) (c : ℕ → ℝ) (hc : ∀ p ∈ P, 0 ≤ c p) (r : Manuscript.Model.Edge N P → ℝ)
  (hr : ∀ (e : Manuscript.Model.Edge N P), 0 ≤ r e)
  (hrc : ∀ (e : Manuscript.Model.Edge N P), r e ≤ c (↑e).card / ↑N ^ ((↑e).card - 1)) :
  Manuscript.SupportMassCounting.supportMass Subtype.val Finset.univ h r v ≤
    Manuscript.SupportMassBound.massConstant P c rho ^ v *
      (↑v / ↑N) ^ (Manuscript.SupportExponent.kappa pmin alpha * ↑v)
Manuscript.SupportMassScale.bound_le_scaled_power (P : Finset ℕ) (c : ℕ → ℝ) (rho pmin alpha t : ℝ) (v : ℕ)
  (hc : ∀ p ∈ P, 0 ≤ c p) (hrho : 1 ≤ rho) (hpmin : 3 ≤ pmin) (ha : 1 / 4 ≤ alpha) (ht : 0 ≤ t) :
  Manuscript.SupportMassBound.massConstant P c rho ^ v * t ^ (Manuscript.SupportExponent.kappa pmin alpha * ↑v) ≤
    (Manuscript.SupportMassScale.supportScale P c rho pmin * t) ^ (Manuscript.SupportExponent.kappa pmin alpha * ↑v)
Manuscript.UniformLowerTail.physical_lower_tail_uniform (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ] (hμ : SpinGlass.Disorder.SymmetricLaw μ)
  (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty)
  (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) (hpN : ∀ p ∈ P, p ≤ N) {beta B h rho z : ℝ} (hbeta : 0 ≤ beta)
  (hbetaB : beta ≤ B) (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a)
  (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) (hz : 0 < z) :
  (SpinGlass.Disorder.iidLaw μ).real {J | Manuscript.Model.normalizedPartition N P a beta h J < z} ≤
    Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho *
        z ^ Manuscript.ConditionalLowerTail.exponent (Manuscript.MixedThreshold.theta P a B) +
      Manuscript.OriginalLawLowerTail.tau μ N P a B (Manuscript.MixedThreshold.theta P a B)
Manuscript.UniformLowerTail.raw_negative_moment_uniform (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ] (hμ : SpinGlass.Disorder.SymmetricLaw μ)
  (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty)
  (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) (hpN : ∀ p ∈ P, p ≤ N) {beta B h rho : ℝ} (hbeta : 0 ≤ beta)
  (hbetaB : beta ≤ B) (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a)
  (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) :
  ∫ (J : Manuscript.Model.Edge N P → ℝ) in
      Manuscript.OriginalLawLowerTail.physicalRawCutoff N P a B (Manuscript.MixedThreshold.theta P a B),
      Manuscript.Model.normalizedPartition N P a beta h J ^
        (-Manuscript.ConditionalLowerTail.exponent
            (Manuscript.MixedThreshold.theta P a B)) ∂SpinGlass.Disorder.iidLaw μ ≤
    Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho
Manuscript.UniformMixedMass.uniform_graphical_mass (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty)
  (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) (hpN : ∀ p ∈ P, p ≤ N) {v h rho : ℝ} (hv : 0 < v)
  (hvT : v < Manuscript.MixedThreshold.thresholdSquared P a) (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) :
  Manuscript.UniformGraphMass.graphMass Subtype.val Finset.univ.powerset h
      (Manuscript.MixedCoefficient.comparisonWeight N P a v) ≤
    Manuscript.UniformMixedMass.massConstant P a v rho
Manuscript.UniformMixedMass.uniform_graphical_mass_midpoint (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty)
  (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) (hpN : ∀ p ∈ P, p ≤ N) {B h rho : ℝ} (hB : 0 < B)
  (hBT : B < Manuscript.MixedThreshold.betaF P a) (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) :
  Manuscript.UniformGraphMass.graphMass Subtype.val Finset.univ.powerset h
      (Manuscript.MixedCoefficient.comparisonWeight N P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2)) ≤
    Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho
Manuscript.UniformPhysicalMass.physical_edge_tail (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ) (a : ℕ → ℝ) (hP : P.Nonempty)
  (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) (hpN : ∀ p ∈ P, p ≤ N) {beta B h rho t : ℝ} (hbeta : 0 ≤ beta)
  (hbetaB : beta ≤ B) (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a)
  (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) (ht : 0 ≤ t) :
  (Manuscript.UniformGraphMass.graphMass Subtype.val ({Γ ∈ Finset.univ.powerset | t < ↑Γ.card}) h fun e =>
        SpinGlass.Disorder.secondMoment μ (Manuscript.DisorderOrthogonality.physicalScale N P a beta e)) ≤
      Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho *
        Manuscript.MixedThreshold.theta P a B ^ (2 * ⌊t⌋₊ + 2) ∧
    Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho *
        Manuscript.MixedThreshold.theta P a B ^ (2 * ⌊t⌋₊ + 2) ≤
      Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho *
        Manuscript.MixedThreshold.theta P a B ^ (2 * t)
Manuscript.UniformPhysicalMass.physical_graphical_mass (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ] (hunit : SpinGlass.Disorder.UnitSecondMoment μ) (N : ℕ) (P : Finset ℕ)
  (a : ℕ → ℝ) (hP : P.Nonempty) (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) (hpN : ∀ p ∈ P, p ≤ N) {beta B h rho : ℝ}
  (hbeta : 0 ≤ beta) (hbetaB : beta ≤ B) (hB : 0 < B) (hBT : B < Manuscript.MixedThreshold.betaF P a)
  (hfield : |h| ≤ rho * ↑N ^ (-(1 / 4))) :
  (Manuscript.UniformGraphMass.graphMass Subtype.val Finset.univ.powerset h fun e =>
      SpinGlass.Disorder.secondMoment μ (Manuscript.DisorderOrthogonality.physicalScale N P a beta e)) ≤
    Manuscript.UniformMixedMass.massConstant P a (Manuscript.MixedThreshold.betaPlus P a B ^ 2) rho
Manuscript.UniformTau.tau_eventually_zero_of_bounded (μ : MeasureTheory.Measure ℝ)
  [MeasureTheory.IsProbabilityMeasure μ] (P : Finset ℕ) (a : ℕ → ℝ) (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p)
  {B θ M : ℝ} (hB : 0 < B) (hθ : 0 < θ) (hθ1 : θ < 1) (hbound : ∀ᵐ (x : ℝ) ∂μ, |x| ≤ M) :
  ∀ᶠ (N : ℕ) in Filter.atTop, Manuscript.OriginalLawLowerTail.tau μ N P a B θ = 0
Manuscript.UniformTau.tau_polynomial_tendsto_zero (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (P : Finset ℕ) (a : ℕ → ℝ) (ha : ∀ p ∈ P, 0 < a p) (pm : ℕ) (hpm : 2 ≤ pm) (hpp : ∀ p ∈ P, pm ≤ p) {B θ m b : ℝ}
  (hB : 0 < B) (hθ : 0 < θ) (hθ1 : θ < 1) (hb : 0 < b) (hm : 2 * (↑pm + b) / (↑pm - 1) ≤ m)
  (hint : MeasureTheory.Integrable (fun x => |x| ^ m) μ) :
  Filter.Tendsto (fun N => ↑N ^ b * Manuscript.OriginalLawLowerTail.tau μ N P a B θ) Filter.atTop (nhds 0)
Manuscript.UniformTau.tau_tendsto_zero_fourth (μ : MeasureTheory.Measure ℝ) [MeasureTheory.IsProbabilityMeasure μ]
  (P : Finset ℕ) (a : ℕ → ℝ) (ha : ∀ p ∈ P, 0 < a p) (hp : ∀ p ∈ P, 2 ≤ p) {B θ : ℝ} (hB : 0 < B) (hθ : 0 < θ)
  (hθ1 : θ < 1) (h4 : MeasureTheory.Integrable (fun x => |x| ^ 4) μ) :
  Filter.Tendsto (fun N => Manuscript.OriginalLawLowerTail.tau μ N P a B θ) Filter.atTop (nhds 0)
SpinGlass.FiniteLowerTail.noisy_negative_moment_le_second_moment.{u_1} {ι : Type u_1} [Fintype ι] [DecidableEq ι]
  {θ : ℝ} (hθ : 0 < θ) (hθ1 : θ < 1) (f : (ι → Bool) → ℝ) (hf : ∀ (ε : ι → Bool), 0 < f ε)
  (hmean : SpinGlass.Expansion.spinMean f = 1) :
  (SpinGlass.Expansion.spinMean fun ε => SpinGlass.Noise.cubeNoise θ f ε ^ (-((1 - √θ) / √θ))) ≤
    SpinGlass.Expansion.spinMean fun ε => f ε ^ 2
SpinGlass.SKBlockPartition.canonical_valid.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [DecidableEq E] (incidence : E → Finset V) (A : Finset V) (Γ : Finset E) :
  SpinGlass.SKBlockPartition.ValidSelection incidence A (SpinGlass.SKBlockPartition.blockFamily incidence A Γ)
SpinGlass.SKBlockPartition.selection_unique.{u_1, u_2} {V : Type u_1} {E : Type u_2} [Fintype V] [DecidableEq V]
  [DecidableEq E] (incidence : E → Finset V) (A : Finset V) (F G : Finset (Finset E)) (hFne : ∀ K ∈ F, K.Nonempty)
  (hGne : ∀ K ∈ G, K.Nonempty) (hFc : ∀ K ∈ F, SpinGlass.SKBlockPartition.Connected incidence A K)
  (hGc : ∀ K ∈ G, SpinGlass.SKBlockPartition.Connected incidence A K)
  (hFd : (↑F).PairwiseDisjoint (SpinGlass.SKBlockPartition.outside incidence A))
  (hGd : (↑G).PairwiseDisjoint (SpinGlass.SKBlockPartition.outside incidence A))
  (hunion : F.biUnion id = G.biUnion id) : F = G
SpinGlass.SKPrimitiveCatalogWalk.primitive_classification.{u_1} {V : Type u_1} [Fintype V] [DecidableEq V]
  (A : Finset V) (K : Finset (Finset V)) (hne : K.Nonempty) (hc : SpinGlass.SKBlockPartition.Connected id A K)
  (h2 : ∀ e ∈ K, e.card = 2) (hd : SpinGlass.SKBlockPartition.OutsideDegreeTwo id A K) :
  (∃ a ∈ A, ∃ b ∈ A, a ≠ b ∧ K = {{a, b}}) ∨
    (∃ a ∈ A,
        ∃ b ∈ A,
          a ≠ b ∧
            ∃ l,
              l.Nodup ∧
                1 ≤ l.length ∧
                  (∀ v ∈ l, v ∉ A) ∧
                    l.toFinset = SpinGlass.SKBlockPartition.outside id A K ∧
                      K = SpinGlass.SKTraversal.betweenEdges a b l) ∨
      (∃ a ∈ A,
          ∃ l,
            l.Nodup ∧
              2 ≤ l.length ∧
                (∀ v ∈ l, v ∉ A) ∧
                  l.toFinset = SpinGlass.SKBlockPartition.outside id A K ∧ K = SpinGlass.SKTraversal.rootedEdges a l) ∨
        ∃ l,
          l.Nodup ∧
            3 ≤ l.length ∧
              (∀ v ∈ l, v ∉ A) ∧
                l.toFinset = SpinGlass.SKBlockPartition.outside id A K ∧ K = SpinGlass.SKTraversal.cycleEdges l
